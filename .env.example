# Copy this file to .env for local testing (git-ignored), or add these as Environment
# Variables in your Vercel project's dashboard for production. Vercel requires a redeploy
# after you add or change env vars — they don't apply retroactively to old deployments.
#
# The contact form tries Resend first (server-side, via api/send-email.ts), then falls back
# to EmailJS (client-side) if that fails or isn't configured. Set up either one, or both for
# redundancy — the form only shows a manual WhatsApp/email fallback if both are unavailable.

# ---- Resend (server-side only — do NOT prefix with VITE_, or it would ship to the browser) ----
# 1. Sign up free at https://resend.com and create an API key under Dashboard -> API Keys.
RESEND_API_KEY=

# All optional below. With nothing set, quote requests go to bookings@ and general enquiries
# to info@ (the Zoho mailboxes), each sent from its own address. Only override to change that.
# Senders must be on the domain verified in Resend (solidcaremobiletoilets.com).

# Quote requests: where they're delivered, and the sender used for them.
CONTACT_TO_EMAIL=bookings@solidcaremobiletoilets.com
RESEND_FROM_EMAIL=Solidcare Bookings <bookings@solidcaremobiletoilets.com>

# General enquiries: where they're delivered, and the sender used for them.
CONTACT_INFO_EMAIL=info@solidcaremobiletoilets.com
RESEND_INFO_FROM_EMAIL=Solidcare Mobile Toilets <info@solidcaremobiletoilets.com>

# ---- EmailJS (client-side fallback — VITE_ prefix required so Vite exposes it to the browser) ----
# 1. Sign up free at https://www.emailjs.com
# 2. Email Services -> Add New Service -> connect the bookings@ mailbox (Zoho, via SMTP)
#    -> copy the Service ID it gives you.
# 3. Email Templates -> Create New Template. Set Subject to {{subject}}, the body to
#    {{message}}, and (recommended) "Reply To" in the template settings to {{reply_to}} so
#    replying to the email goes straight to the visitor -> copy the Template ID.
# 4. Account -> General -> copy your Public Key.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
